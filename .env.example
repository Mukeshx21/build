# ==============================================================================
# LandAI - Environment Variables for Deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments (enforces secure cookies & strict CORS)
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SERVER & PORTS
# ------------------------------------------------------------------------------
# Frontend Vite preview / web port (or platform-assigned $PORT)
PORT=8443

# Node.js Express backend port
BACKEND_PORT=5000

# Python FastAPI OCR service port
OCR_PORT=8000

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (CRITICAL)
# ------------------------------------------------------------------------------
# Strong, unique random string for JWT session signing (at least 32-64 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=generate_a_secure_random_64_character_hex_or_base64_secret_here

# Allowed origins for CORS in production (comma-separated if multiple)
# Example: https://landai.example.com,https://api.landai.example.com
CORS_ORIGINS=https://your-frontend-domain.com

# ------------------------------------------------------------------------------
# 4. SERVICE URLS & PROXY CONFIGURATION
# ------------------------------------------------------------------------------
# Frontend public API base URL (leave empty if served on same origin / reverse proxy)
VITE_API_BASE_URL=

# Public or reverse-proxy URL to the Python OCR service (accessible by client/Vite)
VITE_OCR_API_URL=http://127.0.0.1:8000

# Internal backend-to-backend URL used by Node.js to communicate with Python OCR
# In Docker / Kubernetes: http://ocr-service:8000 or http://127.0.0.1:8000 on single VM
OCR_INTERNAL_URL=http://127.0.0.1:8000

# Optional path to Python binary if auto-spawned by backend
PYTHON_CMD=python

# ------------------------------------------------------------------------------
# 5. TESSERACT OCR ENGINE (Python FastAPI)
# ------------------------------------------------------------------------------
# Full path to the Tesseract binary
# Linux / Docker: /usr/bin/tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract

# Directory containing Tesseract language training data (eng.traineddata, tam.traineddata)
# Linux / Docker: /usr/share/tesseract-ocr/5/tessdata
# Windows: C:\Program Files\Tesseract-OCR\tessdata
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Optional: Directory for custom fine-tuned tessdata models
# TESSDATA_DIR=./OCR/data/tessdata

# Tesseract Page Segmentation Mode (PSM 6 = Assume a single uniform block of text)
LANDAI_OCR_PSM=6
LANDAI_OCR_MODEL_VERSION=tesseract-default

# Path to Tamil font for PDF/image overlay rendering
# Linux: /usr/share/fonts/truetype/noto/NotoSansTamil-Regular.ttf
# Windows: C:\Windows\Fonts\NotoSansTamil-Regular.ttf
# LANDAI_TAMIL_FONT=/usr/share/fonts/truetype/noto/NotoSansTamil-Regular.ttf

# ------------------------------------------------------------------------------
# 6. LAND VALIDATION RULES
# ------------------------------------------------------------------------------
# State rules profile for legal land validation engine (default: tamil_nadu)
LAND_VALIDATION_STATE=tamil_nadu

# Optional: Official Government Land API endpoint for external verification
# OFFICIAL_LAND_API_URL=https://eservices.tn.gov.in/eservicesnew/land/chitta.html
