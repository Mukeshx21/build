{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ocr",
      "destination": "/api/ocr.py"
    },
    {
      "source": "/api/ocr/:match*",
      "destination": "/api/ocr.py"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
